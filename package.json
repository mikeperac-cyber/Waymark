{
  "name": "waymark",
  "productName": "Waymark",
  "version": "1.0.0",
  "description": "Personal offline workspace for links, tools, tasks, notes, and reminders",
  "author": "Waymark",
  "private": true,
  "sideEffects": false,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --config vite.electron.config.ts",
    "build": "vite build --config vite.electron.config.ts",
    "desktop:build": "vite build --config vite.electron.config.ts",
    "desktop:package": "node scripts/rebuild-exe.mjs",
    "desktop:dist": "bun run desktop:build && electron-builder --win --x64",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@tailwindcss/vite": "^4.1.11",
    "@tanstack/react-router": "^1.120.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.525.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.11",
    "tw-animate-css": "^1.3.4",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@electron/asar": "^4.0.1",
    "@types/node": "^22.16.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.0.0",
    "electron-builder": "^26.0.12",
    "jsdom": "^26.1.0",
    "rcedit": "^4.0.1",
    "typescript": "^5.8.3",
    "vite": "^7.0.4",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.waymark.desktop",
    "productName": "Waymark",
    "electronVersion": "45.0.0",
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "files": [
      "dist-electron/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "electron/assets/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "Waymark-Portable-x64.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Waymark",
      "artifactName": "Waymark-Setup-x64.exe"
    }
  }
}
